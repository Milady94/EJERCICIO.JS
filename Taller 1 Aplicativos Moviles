             * no se le cobrara IVA; si el promedio obtenido es menor que 4.5 deberá 
             * pagar la matrícula completa, la cual incluye el 10% de IVA. 
             * Obtener cuanto debe pagar un aprendiz.*/

            // Variables de entrada 

            int matricula = 3500000;
            float promedio;
            int descuento;
            int iva;
            int totalpagar;



            //Datos de entrada 
            Console.WriteLine("Ingrese su promedio");
            promedio = float.Parse(Console.ReadLine());

            //proceso

            if (promedio >= 4.5)
            {

                descuento = matricula * 30 / 100;
                iva = 0;

            }
            else {

                descuento = 0;
                iva = matricula * 10 / 100;
                            
            }


            totalpagar = matricula - descuento + iva;

            Console.WriteLine("Valor de la matricula es de: " + matricula);
            Console.WriteLine("Valor su descuento es de: " + descuento);
            Console.WriteLine("EL IVA a cobrar es de: " + iva);
            Console.WriteLine("Valor a pagar es de: " + totalpagar);

